# Магазин удобрений
@dp.message_handler(text="🛒 Магазин удобрений")
async def fertilizer_shop(message: types.Message):
    cursor.execute("SELECT * FROM products WHERE name LIKE '%Буйские%'")
    products = cursor.fetchall()
    
    for product in products:
        product_id, name, description, price, photo_id = product
        caption = f"🌱 {name}\n\n{description}\n\nЦена: {price}₽"
        
        if photo_id:
            await bot.send_photo(
                message.from_user.id,
                photo_id,
                caption=caption,
                reply_markup=types.InlineKeyboardMarkup().add(
                    types.InlineKeyboardButton("Купить", callback_data=f"buy_{product_id}")
                )
            )
        else:
            await message.answer(
                caption,
                reply_markup=types.InlineKeyboardMarkup().add(
                    types.InlineKeyboardButton("Купить", callback_data=f"buy_{product_id}")
                )
            )

